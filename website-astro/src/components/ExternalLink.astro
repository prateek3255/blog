---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    'text-foreground underline underline-offset-2 hover:opacity-70 transition-opacity',
    className,
  ]}
  target="_blank"
  rel="noopener noreferrer"
>
  <slot />
</a>
