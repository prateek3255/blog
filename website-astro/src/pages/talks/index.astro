---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const talks = await getCollection('talks');
---

<Layout
  title="Talks — Prateek Surana"
  description="Conference talks, presentations, and videos."
>
  <Nav />
  <main class="max-w-2xl mx-auto px-6 pb-24">
    <section class="pt-16 pb-10 border-b border-border">
      <h1 class="font-serif text-3xl font-semibold">Talks</h1>
      <p class="mt-3 text-muted-foreground text-[0.9375rem] leading-relaxed">
        Conference talks and presentations I have given.
      </p>
    </section>

    <section class="pt-8">
      <div class="flex flex-col gap-12">
        {talks.map((entry) => {
          const talk = entry.data;
          return (
            <article>
              <!-- YouTube thumbnail -->
              <a
                href={`https://www.youtube.com/watch?v=${talk.youtubeId}`}
                target="_blank"
                rel="noopener noreferrer"
                class="block group"
                aria-label={`Watch ${talk.title} on YouTube`}
              >
                <div class="relative w-full aspect-video bg-muted overflow-hidden border border-border">
                  <img
                    src={`https://img.youtube.com/vi/${talk.youtubeId}/maxresdefault.jpg`}
                    alt={`Thumbnail for ${talk.title}`}
                    class="w-full h-full object-cover group-hover:opacity-80 transition-opacity"
                  />
                  <!-- Play button overlay -->
                  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <div class="w-14 h-14 rounded-full bg-background/90 flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform">
                      <svg
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="w-6 h-6 text-foreground ml-0.5"
                        aria-hidden="true"
                      >
                        <path d="M8 5v14l11-7z" />
                      </svg>
                    </div>
                  </div>
                </div>
              </a>

              <!-- Metadata -->
              <div class="mt-4">
                <div class="flex items-center gap-2 text-xs text-muted-foreground mb-2">
                  <span>{talk.event}</span>
                  <span aria-hidden="true">·</span>
                  <span>{talk.date}</span>
                </div>
                <h2 class="font-serif text-[1.125rem] leading-snug font-medium text-foreground text-balance">
                  {talk.title}
                </h2>
                <p class="mt-1.5 text-sm text-muted-foreground leading-relaxed">
                  {talk.description}
                </p>
                <a
                  href={`https://www.youtube.com/watch?v=${talk.youtubeId}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-foreground transition-colors group"
                >
                  Watch on YouTube
                  <span aria-hidden="true" class="group-hover:translate-x-0.5 transition-transform">↗</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
