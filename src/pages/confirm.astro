---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Confirm your email — Prateek Surana"
  description="One last step to confirm your newsletter subscription."
>
  <Nav />
  <main class="max-w-2xl mx-auto px-6 pb-24">
    <section class="pt-16">
      <h1 class="font-serif text-3xl font-semibold leading-tight mb-8">One Last Step...</h1>
      <p class="text-[0.9375rem] text-muted-foreground leading-relaxed">
        Thank you for subscribing. Please check your inbox and confirm your subscription to start receiving emails.
      </p>
    </section>
  </main>
  <Footer />
</Layout>
